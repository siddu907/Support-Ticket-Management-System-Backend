          }
        }
      ]
    },
    {
      "name": "Attachments",
      "item": [
        {
          "name": "Upload Attachment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{base_url}}/tickets/{{ticketId}}/attachments", "host": ["{{base_url}}"], "path": ["tickets", "{{ticketId}}", "attachments"] }
